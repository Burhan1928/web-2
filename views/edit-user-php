<?php
require_once __DIR__ . '/../models/User.php';

use models\User;

if (!isset($_GET['id'])) {
    header("Location: list-user.php");
    exit;
}

$user = User::find($_GET['id']);

if (!$user) {
    header("Location: list-user.php");
    exit;
}

if (isset($_POST['submit'])) {
    $data = [
        'id' => $_GET['id'],
        'firstname' => $_POST['firstname'],
        'lastname' => $_POST['lastname'],
        'gender' => $_POST['gender'],
        'age' => $_POST['age'],
        'weight' => $_POST['weight'],
    ];

    User::update($data);
    header("Location: list-user.php");
    exit;
}
?>

